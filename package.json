{
  "name": "notes-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w @notes/server",
    "dev:client": "npm run dev -w @notes/client",
    "build": "npm run build -w @notes/client",
    "start": "npm start -w @notes/server",
    "test": "npm test -w @notes/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @notes/client"
  }
}
